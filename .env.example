# Copy to .env (git-ignored) and replace every CHANGE_ME value. Never commit real secrets.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SECRET_KEY=CHANGE_ME_long_random_string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:8501
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
THROTTLE_AUTH_RATE=20/min

# --- PostgreSQL / Redis ---
# Local venv: host = localhost.  Inside docker compose these are overridden to `db` / `redis`.
POSTGRES_DB=tunisovereign_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Host-side port published by docker compose (change it if 5432 is already used on your machine,
# then set POSTGRES_PORT to the same value for the local venv).
POSTGRES_HOST_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0

# --- Telemetry ingestion (HMAC-SHA256 packet signing; shared by gRPC server and simulator) ---
TELEMETRY_HMAC_SECRET=CHANGE_ME_telemetry_hmac_secret
TELEMETRY_MAX_FUTURE_SKEW_SECONDS=300
GRPC_PORT=50051
# Optional TLS for gRPC (HMAC is NOT a substitute for transport security). Paths to PEM files:
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=

# --- Simulator credentials (an AGENT_SERVICE account created by `manage.py seed_tunihara`) ---
SEED_DEMO_PASSWORD=CHANGE_ME_demo_password_min_10_chars
SIMULATOR_GRPC_TARGET=127.0.0.1:50051
SIMULATOR_API_URL=http://127.0.0.1:8000
SIMULATOR_USERNAME=agent_service
SIMULATOR_PASSWORD=
GRPC_TLS_CA_FILE=

# ---------------- Weeks 2-4 (unused in Week 1) ----------------
# Free LLM Provider (Groq Free Developer Tier or Local Ollama)
GROQ_API_KEY=gsk_your_free_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Local Foundry Anvil only (Week 3). Use one of the throw-away dev accounts that `anvil` prints at startup,
# and keep it in your private .env. NEVER put a key that holds real funds here or in any tracked file, and never
# reuse an Anvil key on a public testnet or mainnet.
WEB3_RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=CHANGE_ME_deployed_contract_address
AGENT_PRIVATE_KEY=CHANGE_ME_local_anvil_dev_private_key
